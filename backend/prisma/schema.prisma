generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id            String   @id @default(cuid())
  email         String   @unique
  displayName   String
  elo           Int      @default(1200)
  rankingsOptIn Boolean  @default(false)
  createdAt     DateTime @default(now())

  matchesAsA Match[] @relation("PlayerA")
  matchesAsB Match[] @relation("PlayerB")
  matchesWon Match[] @relation("Winner")
  tournamentEntrants TournamentEntrant[]

  @@index([elo])
}

enum EventType {
  practice
  tournament
  social
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  time        String?
  location    String
  type        EventType
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model RankingsViewer {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Match {
  id              String   @id @default(cuid())
  playedAt        DateTime
  playerAId       String
  playerBId       String
  winnerId        String
  playerAElo      Int
  playerBElo      Int
  playerAEloAfter Int
  playerBEloAfter Int
  sets            Json
  createdAt       DateTime @default(now())

  playerA Player @relation("PlayerA", fields: [playerAId], references: [id])
  playerB Player @relation("PlayerB", fields: [playerBId], references: [id])
  winner  Player @relation("Winner", fields: [winnerId], references: [id])
  tournamentMatch TournamentMatch?

  @@index([playedAt])
}

enum TournamentFormat {
  single_elimination
  double_elimination
  round_robin
}

enum TournamentStatus {
  draft
  seeded
  in_progress
  completed
}

enum BracketSide {
  winners
  losers
  grand_final
}

model Tournament {
  id             String           @id @default(cuid())
  name           String
  format         TournamentFormat
  status         TournamentStatus @default(draft)
  createdByEmail String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  entrants TournamentEntrant[]
  matches  TournamentMatch[]

  @@index([status])
}

model TournamentEntrant {
  id           String   @id @default(cuid())
  tournamentId String
  playerId     String
  seed         Int
  eloAtSeed    Int
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id])

  matchesAsEntrantA TournamentMatch[] @relation("EntrantA")
  matchesAsEntrantB TournamentMatch[] @relation("EntrantB")
  matchesWon        TournamentMatch[] @relation("WinnerEntrant")

  @@unique([tournamentId, playerId])
  @@unique([tournamentId, seed])
  @@index([tournamentId])
}

model TournamentMatch {
  id           String       @id @default(cuid())
  tournamentId String
  bracketSide  BracketSide?
  round        Int
  position     Int

  entrantAId  String?
  entrantBId  String?
  isBye       Boolean @default(false)
  conditional Boolean @default(false)
  skipped     Boolean @default(false)

  matchId         String? @unique
  winnerEntrantId String?

  nextMatchId        String?
  nextMatchSlot      String?
  loserNextMatchId   String?
  loserNextMatchSlot String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournament     Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  entrantA       TournamentEntrant? @relation("EntrantA", fields: [entrantAId], references: [id])
  entrantB       TournamentEntrant? @relation("EntrantB", fields: [entrantBId], references: [id])
  winnerEntrant  TournamentEntrant? @relation("WinnerEntrant", fields: [winnerEntrantId], references: [id])
  match          Match?             @relation(fields: [matchId], references: [id])
  nextMatch      TournamentMatch?   @relation("Advancement", fields: [nextMatchId], references: [id])
  previousMatches TournamentMatch[] @relation("Advancement")
  loserNextMatch      TournamentMatch?   @relation("LoserAdvancement", fields: [loserNextMatchId], references: [id])
  previousLoserMatches TournamentMatch[] @relation("LoserAdvancement")

  @@index([tournamentId])
  @@index([tournamentId, bracketSide, round])
}
